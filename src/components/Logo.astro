---
import content from "../data/content.json";
const { business } = content;

interface Props {
  // tailwind text-size utility for the wordmark, e.g. "text-lg"
  size?: string;
}
const { size = "text-lg" } = Astro.props;
---

<span class="flex items-center gap-2.5">
  <!-- coastal current mark: stacked waves flowing into a node -->
  <svg
    class="h-7 w-7 flex-shrink-0"
    viewBox="0 0 28 28"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <path d="M2 9c2.4 0 2.4-2.5 4.8-2.5S9.2 9 11.6 9 14 6.5 16.4 6.5 18.8 9 21.2 9s2.4-2.5 4.8-2.5" stroke="var(--color-sage)" stroke-width="2" stroke-linecap="round" />
    <path d="M2 14c2.4 0 2.4-2.5 4.8-2.5S9.2 14 11.6 14s2.4-2.5 4.8-2.5S18.8 14 21.2 14s2.4-2.5 4.8-2.5" stroke="var(--color-crail)" stroke-width="2" stroke-linecap="round" />
    <path d="M2 19c2.4 0 2.4-2.5 4.8-2.5S9.2 19 11.6 19s2.4-2.5 4.8-2.5S18.8 19 21.2 19s2.4-2.5 4.8-2.5" stroke="var(--color-crail)" stroke-width="2" stroke-linecap="round" stroke-opacity="0.5" />
  </svg>
  <span class={`font-serif font-medium tracking-tight ${size}`}>{business.name}</span>
</span>
