---
import content from "../data/content.json";
const { whatWeDo, services, digitalPresence, useCases } = content;

const autoIcons = [
  `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v16a2 2 0 0 0 2 2h16"/><path d="m19 9-5 5-4-4-3 3"/></svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.376 3.622a1 1 0 0 1 3.002 3.002L7.368 18.635a2 2 0 0 1-.855.506l-2.872.838a.5.5 0 0 1-.62-.62l.838-2.872a2 2 0 0 1 .506-.854z"/></svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>`,
];

const dpIcons = [
  `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/></svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/></svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m4.93 4.93 4.24 4.24"/><path d="m14.83 9.17 4.24-4.24"/><path d="m14.83 14.83 4.24 4.24"/><path d="m9.17 14.83-4.24 4.24"/><circle cx="12" cy="12" r="4"/></svg>`,
];

const bgScale = (svg: string) =>
  svg.replace('width="24" height="24"', 'width="80" height="80"').replace('stroke-width="1.5"', 'stroke-width="0.75"');
---

<section id="services" class="border-t border-warm-gray bg-card px-6 py-16 md:py-20">
  <div class="mx-auto max-w-6xl">
    <h2 class="font-serif text-4xl font-semibold text-center text-warm-black">
      {whatWeDo.heading}
    </h2>
    <p class="mx-auto mt-3 max-w-2xl text-center text-warm-black/60 text-lg">
      {whatWeDo.subheading}
    </p>

    <!-- Pillar: Automation -->
    <div class="mt-14">
      <div class="flex flex-col items-center text-center">
        <span class="text-sm font-semibold uppercase tracking-wider text-crail">{services.pillarLabel}</span>
        <h3 class="mt-1 font-serif text-2xl font-medium text-warm-black md:text-3xl">{services.pillarTagline}</h3>
        <p class="mt-2 max-w-xl text-base text-warm-black/55">{services.subheading}</p>
      </div>
      <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {services.items.map((service, i) => (
          <a href={`/use-cases#${useCases.items[i].slug}`} class="group relative overflow-hidden rounded-xl border border-warm-gray bg-warm-white p-6 transition-all duration-200 hover:-translate-y-1 hover:border-crail/30 hover:shadow-md hover:shadow-warm-black/5">
            <div class="pointer-events-none absolute -right-4 -bottom-4 text-crail/[0.04] transition-all duration-300 group-hover:text-crail/[0.08] group-hover:scale-110">
              <Fragment set:html={bgScale(autoIcons[i])} />
            </div>
            <div class="relative">
              <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-crail/10 text-crail transition-colors group-hover:bg-crail/15">
                <Fragment set:html={autoIcons[i]} />
              </div>
              <h4 class="mt-4 font-serif text-xl font-medium text-warm-black">
                {service.title}
              </h4>
              <p class="mt-1.5 text-base leading-relaxed text-warm-black/60">
                {service.description}
              </p>
              <ul class="mt-3 space-y-1">
                {service.examples.map((example) => (
                  <li class="flex items-start gap-2 text-sm text-warm-black/50">
                    <span class="mt-1.5 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-crail/30" />
                    {example}
                  </li>
                ))}
              </ul>
              <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-crail transition-colors group-hover:text-crail-hover">
                Learn more
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-0.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- Pillar: Digital Presence -->
    <div class="mt-16">
      <div class="flex flex-col items-center text-center">
        <span class="text-sm font-semibold uppercase tracking-wider text-sage">{digitalPresence.pillarLabel}</span>
        <h3 class="mt-1 font-serif text-2xl font-medium text-warm-black md:text-3xl">{digitalPresence.pillarTagline}</h3>
        <p class="mt-2 max-w-xl text-base text-warm-black/55">{digitalPresence.subheading}</p>
      </div>
      <div class="mt-8 grid gap-4 md:grid-cols-2">
        {digitalPresence.items.map((service, i) => (
          <div class="group relative overflow-hidden rounded-xl border border-warm-gray bg-warm-white p-6">
            <div class="pointer-events-none absolute -right-4 -bottom-4 text-sage/[0.05]">
              <Fragment set:html={bgScale(dpIcons[i])} />
            </div>
            <div class="relative">
              <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-sage/10 text-sage">
                <Fragment set:html={dpIcons[i]} />
              </div>
              <h4 class="mt-4 font-serif text-xl font-medium text-warm-black">
                {service.title}
              </h4>
              <p class="mt-1.5 text-base leading-relaxed text-warm-black/60">
                {service.description}
              </p>
              <ul class="mt-3 space-y-1">
                {service.examples.map((example) => (
                  <li class="flex items-start gap-2 text-sm text-warm-black/50">
                    <span class="mt-1.5 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-sage/40" />
                    {example}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
