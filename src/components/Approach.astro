---
import content from "../data/content.json";
const { approach } = content;
---

<section id="approach" class="border-t border-warm-gray px-6 py-14 md:py-16">
  <div class="mx-auto flex max-w-3xl flex-col items-center gap-3 text-center">
    <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-crail/10 text-crail">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .962 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.962 0z"/><path d="M20 3v4"/><path d="M22 5h-4"/><path d="M4 17v2"/><path d="M5 18H3"/></svg>
    </div>
    <h2 class="font-serif text-3xl font-semibold text-warm-black">
      {approach.heading}
    </h2>
    <p class="max-w-2xl text-lg leading-relaxed text-warm-black/60">
      {approach.subheading}
    </p>
  </div>
</section>
